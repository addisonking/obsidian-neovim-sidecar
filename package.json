{
	"name": "obsidian-neovim-sidecar",
	"version": "1.11.0",
	"description": "a simple replacement for edit-in-neovim with tmux sidecar support across macOS and Linux terminals",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"dev:vault": "node scripts/dev.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.8",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"tslib": "2.4.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
